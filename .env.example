# ============================================
# 환경변수 설정 가이드
# 이 파일을 .env로 복사한 후 실제 값을 입력하세요
# cp .env.example .env
# ============================================

# Anthropic API (서버 전용 — 프론트엔드에 노출되지 않음)
ANTHROPIC_API_KEY=sk-ant-xxx

# Supabase (VITE_ 접두사 = 프론트엔드 빌드에 포함)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Supabase Service Role (서버 전용 — 절대 프론트엔드에 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 프론트엔드 → 백엔드 API URL
# 로컬 개발: http://localhost:3001
# Vercel 배포: 비워두면 같은 도메인 사용
VITE_API_BASE_URL=http://localhost:3001

# 서버 환경
NODE_ENV=development

# CORS 허용 오리진 (쉼표 구분)
# 로컬: 설정 안 하면 localhost:5173, localhost:3000 기본 허용
# 프로덕션: https://your-domain.com
# CORS_ORIGINS=https://profit.daewoong.co.kr
